<Window

x:Class="NGPB.Launcher.LoginWindow"

xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"


Width="500"

Height="600"

Background="#07111F"

WindowStyle="None">


<Grid>


<StackPanel

Margin="60"

VerticalAlignment="Center">


<Image

Source="/Assets/user.png"

Width="100"

Height="100"/>



<TextBlock

Text="NGPB ACCOUNT"

Foreground="White"

FontSize="32"

Margin="0,20"/>



<TextBox

x:Name="UsernameBox"

Height="45"

FontSize="18"/>



<PasswordBox

x:Name="PasswordBox"

Height="45"

Margin="0,15"/>



<Button

Content="LOGIN"

Height="55"

FontSize="22"

Click="Login_Click"/>


</StackPanel>


</Grid>


</Window>
