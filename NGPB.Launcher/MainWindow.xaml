<Window x:Class="NGPB.Launcher.MainWindow"

xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

Title="NG PB Launcher"

Width="1280"

Height="720"

WindowStartupLocation="CenterScreen"

WindowStyle="None"

AllowsTransparency="True"

Background="Transparent">


<Window.Resources>


    <!-- FADE IN -->

    <Storyboard x:Key="FadeIn">

        <DoubleAnimation

            Storyboard.TargetProperty="Opacity"

            From="0"

            To="1"

            Duration="0:0:1"/>

    </Storyboard>



    <!-- FADE OUT -->

    <Storyboard x:Key="FadeOut">

        <DoubleAnimation

            Storyboard.TargetProperty="Opacity"

            From="1"

            To="0"

            Duration="0:0:1"/>

    </Storyboard>



    <!-- BUTTON STYLE -->

    <Style x:Key="LauncherButton"
           TargetType="Button">


        <Setter Property="Background"
                Value="#152A42"/>


        <Setter Property="Foreground"
                Value="White"/>


        <Setter Property="FontWeight"
                Value="Bold"/>


        <Setter Property="BorderThickness"
                Value="0"/>


        <Setter Property="Cursor"
                Value="Hand"/>


        <Setter Property="Template">


            <Setter.Value>


                <ControlTemplate TargetType="Button">


                    <Border

                    Background="{TemplateBinding Background}"

                    CornerRadius="10">


                        <ContentPresenter

                        HorizontalAlignment="Center"

                        VerticalAlignment="Center"/>


                    </Border>


                </ControlTemplate>


            </Setter.Value>


        </Setter>


    </Style>



</Window.Resources>






<Grid>





<!-- ==========================
     BACKGROUND VIDEO
========================== -->


<MediaElement

x:Name="BackgroundVideo"

Source="Assets/background.mp4"

LoadedBehavior="Manual"

UnloadedBehavior="Stop"

Stretch="UniformToFill"

Volume="0"/>





<!-- DARK OVERLAY -->


<Border

Background="#B8050B14"/>






<!-- ==========================
     MAIN UI
========================== -->


<Grid Margin="35">



<Grid.RowDefinitions>

<RowDefinition Height="100"/>

<RowDefinition/>

<RowDefinition Height="70"/>

</Grid.RowDefinitions>







<!-- HEADER -->


<Grid Grid.Row="0">


<Grid.ColumnDefinitions>

<ColumnDefinition/>

<ColumnDefinition Width="250"/>

</Grid.ColumnDefinitions>





<StackPanel Orientation="Horizontal">


<Image

Source="Assets/logo.png"

Width="80"

Height="80"/>





<StackPanel Margin="20,0,0,0">


<TextBlock

Text="NG PB"

FontSize="38"

FontWeight="Bold"

Foreground="White"/>




<TextBlock

Text="SECURE GAME LAUNCHER"

Foreground="#6EA8FF"

FontSize="14"/>



</StackPanel>


</StackPanel>








<!-- SERVER BOX -->


<Border

Grid.Column="1"

Background="#99102030"

CornerRadius="12"

Padding="15">


<StackPanel>


<TextBlock

Text="SERVER"

Foreground="Gray"/>




<TextBlock

x:Name="ServerStatus"

Text="ONLINE"

Foreground="#00FF88"

FontSize="22"

FontWeight="Bold"/>



</StackPanel>



</Border>



</Grid>









<!-- CENTER -->


<Grid Grid.Row="1">


<StackPanel

VerticalAlignment="Center"

HorizontalAlignment="Center">





<TextBlock

Text="WELCOME TO POINT BLANK NG"

Foreground="White"

FontSize="30"

FontWeight="Bold"

HorizontalAlignment="Center"/>





<TextBlock

Text="Secure Update System"

Foreground="#9AB4D0"

Margin="0,10,0,30"

HorizontalAlignment="Center"/>









<Border

Width="650"

Background="#AA101D2E"

CornerRadius="15"

Padding="20">



<StackPanel>



<TextBlock

x:Name="DownloadText"

Text="Ready"

Foreground="White"

FontSize="18"

TextAlignment="Center"/>







<ProgressBar

x:Name="Progress"

Height="25"

Minimum="0"

Maximum="100"

Margin="0,20,0,0"/>



</StackPanel>


</Border>








<!-- BUTTON -->

<StackPanel

Orientation="Horizontal"

HorizontalAlignment="Center"

Margin="0,30,0,0">





<Button

x:Name="UpdateButton"

Style="{StaticResource LauncherButton}"

Content="⚡ START UPDATE"

Width="220"

Height="55"

FontSize="18"

Click="UpdateButton_Click"/>







<Button

x:Name="PauseButton"

Style="{StaticResource LauncherButton}"

Content="⏸ PAUSE"

Width="120"

Height="55"

Margin="15,0"

Click="Pause_Click"/>







<Button

x:Name="ResumeButton"

Style="{StaticResource LauncherButton}"

Content="▶ RESUME"

Width="120"

Height="55"

Click="Resume_Click"/>



</StackPanel>





</StackPanel>



</Grid>










<!-- FOOTER -->


<Grid Grid.Row="2">


<StackPanel HorizontalAlignment="Center">


<TextBlock

Text="NG PB Launcher © 2026"

Foreground="Gray"/>



<TextBlock

Text="Anti Cheat • SHA256 • Secure Update"

Foreground="#6EA8FF"/>



</StackPanel>


</Grid>





</Grid>









<!-- ==========================
     LOADING SCREEN
========================== -->


<Grid

x:Name="LoadingScreen"

Background="#DD050B14">





<StackPanel

HorizontalAlignment="Center"

VerticalAlignment="Center">





<Image

Source="Assets/logo.png"

Width="130"

Height="130"/>





<TextBlock

Text="NG PB"

FontSize="50"

FontWeight="Bold"

Foreground="White"

HorizontalAlignment="Center"/>






<TextBlock

x:Name="LoadingText"

Text="Initializing Security..."

Foreground="#6EA8FF"

FontSize="18"

Margin="0,20"/>






<ProgressBar

Width="350"

Height="15"

IsIndeterminate="True"/>






</StackPanel>


</Grid>





</Grid>


</Window>
