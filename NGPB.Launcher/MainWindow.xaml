<StackPanel
    Orientation="Horizontal"
    HorizontalAlignment="Center"
    Margin="0,20,0,0">


    <!-- START UPDATE -->

    <Button
        x:Name="UpdateButton"
        Content="⚡ START UPDATE"
        Width="220"
        Height="55"
        FontSize="18"
        FontWeight="Bold"
        Cursor="Hand"
        Click="UpdateButton_Click"/>


    <!-- PAUSE -->

    <Button
        x:Name="PauseButton"
        Content="⏸ PAUSE"
        Width="120"
        Height="55"
        Margin="15,0"
        FontSize="16"
        Cursor="Hand"
        Click="Pause_Click"/>


    <!-- RESUME -->

    <Button
        x:Name="ResumeButton"
        Content="▶ RESUME"
        Width="120"
        Height="55"
        FontSize="16"
        Cursor="Hand"
        Click="Resume_Click"/>


</StackPanel>
