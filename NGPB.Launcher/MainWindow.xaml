<Window x:Class="NGPB.Launcher.MainWindow"

xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

Title="NG PB Launcher"

Width="1280"

Height="720"

WindowStartupLocation="CenterScreen"

WindowStyle="None"

AllowsTransparency="True"

Background="Transparent">



<Window.Resources>


    <!-- BUTTON STYLE -->

    <Style x:Key="LauncherButton"
           TargetType="Button">


        <Setter Property="Background"
                Value="#16283D"/>


        <Setter Property="Foreground"
                Value="White"/>


        <Setter Property="BorderThickness"
                Value="0"/>


        <Setter Property="FontWeight"
                Value="Bold"/>


        <Setter Property="Cursor"
                Value="Hand"/>


        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">


                    <Border

                    Background="{TemplateBinding Background}"

                    CornerRadius="10">


                        <ContentPresenter

                        HorizontalAlignment="Center"

                        VerticalAlignment="Center"/>


                    </Border>


                </ControlTemplate>

            </Setter.Value>


        </Setter>


    </Style>



</Window.Resources>





<Grid>


<!-- BACKGROUND -->

<Border

CornerRadius="20"

Background="#07121F">


</Border>





<!-- MAIN -->

<Grid Margin="30">


<Grid.RowDefinitions>

<RowDefinition Height="100"/>

<RowDefinition/>

<RowDefinition Height="80"/>

</Grid.RowDefinitions>





<!-- HEADER -->


<Grid Grid.Row="0">


<Grid.ColumnDefinitions>

<ColumnDefinition/>

<ColumnDefinition Width="250"/>

</Grid.ColumnDefinitions>





<StackPanel Orientation="Horizontal">


<Image

Source="Assets/logo.png"

Width="80"

Height="80"/>




<StackPanel Margin="20,0,0,0">


<TextBlock

Text="NG PB"

FontSize="36"

FontWeight="Bold"

Foreground="White"/>


<TextBlock

Text="SECURE GAME LAUNCHER"

FontSize="14"

Foreground="#6EA8FF"/>


</StackPanel>


</StackPanel>







<!-- SERVER -->

<Border

Grid.Column="1"

Background="#101D2E"

CornerRadius="12"

Padding="15">


<StackPanel>


<TextBlock

Text="SERVER STATUS"

Foreground="Gray"/>



<TextBlock

x:Name="ServerStatus"

Text="ONLINE"

FontSize="22"

Foreground="#00FF88"

FontWeight="Bold"/>


</StackPanel>


</Border>



</Grid>








<!-- CENTER -->

<Grid Grid.Row="1">



<StackPanel

HorizontalAlignment="Center"

VerticalAlignment="Center">





<TextBlock

Text="WELCOME TO POINT BLANK NG"

Foreground="White"

FontSize="28"

FontWeight="Bold"

HorizontalAlignment="Center"/>





<TextBlock

Text="Secure Update System"

Foreground="#8EA8C8"

FontSize="16"

HorizontalAlignment="Center"

Margin="0,5,0,30"/>







<!-- DOWNLOAD INFO -->


<Border

Background="#101D2E"

CornerRadius="12"

Width="650"

Padding="20">



<StackPanel>



<TextBlock

x:Name="DownloadText"

Text="Ready"

Foreground="White"

FontSize="18"

TextAlignment="Center"/>





<ProgressBar

x:Name="Progress"

Height="25"

Margin="0,20,0,0"

Minimum="0"

Maximum="100"/>




</StackPanel>


</Border>








<!-- BUTTON -->


<StackPanel

Orientation="Horizontal"

HorizontalAlignment="Center"

Margin="0,30,0,0">





<Button

x:Name="UpdateButton"

Style="{StaticResource LauncherButton}"

Content="⚡ START UPDATE"

Width="220"

Height="55"

FontSize="18"

Click="UpdateButton_Click"/>







<Button

x:Name="PauseButton"

Style="{StaticResource LauncherButton}"

Content="⏸ PAUSE"

Width="120"

Height="55"

Margin="15,0"

FontSize="16"

Click="Pause_Click"/>







<Button

x:Name="ResumeButton"

Style="{StaticResource LauncherButton}"

Content="▶ RESUME"

Width="120"

Height="55"

FontSize="16"

Click="Resume_Click"/>



</StackPanel>







</StackPanel>


</Grid>








<!-- FOOTER -->


<Grid Grid.Row="2">


<StackPanel

HorizontalAlignment="Center">


<TextBlock

Text="NG PB Launcher © 2026"

Foreground="Gray"

FontSize="14"/>



<TextBlock

Text="Secure Client • Anti Cheat • SHA256 Verification"

Foreground="#6EA8FF"

FontSize="12"/>


</StackPanel>



</Grid>





</Grid>


</Grid>


</Window>
